@using MarketService.DTOs
@{
    ViewData["Title"] = "Trang chủ";
    var products = ViewBag.Products as List<ProductResponseDTO> ?? new List<ProductResponseDTO>();
    var posts = ViewBag.Posts as List<PostResponseDTO> ?? new List<PostResponseDTO>();
    var categories = ViewBag.Categories as List<CategoryDTO> ?? new List<CategoryDTO>();

    var catImages = new Dictionary<string, string> {
        { "Điện tử", "https://images.unsplash.com/photo-1498049794561-7780e7231661?w=400&q=80" },
        { "Thời trang", "https://images.unsplash.com/photo-1445205170230-053b83016050?w=400&q=80" },
        { "Gia dụng", "https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=400&q=80" },
        { "Sách", "https://images.unsplash.com/photo-1512820790803-83ca734da794?w=400&q=80" },
        { "Khác", "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400&q=80" }
    };

    string GetCatImage(CategoryDTO cat) {
        if (!string.IsNullOrEmpty(cat.ImageUrl)) return cat.ImageUrl;
        return catImages.ContainsKey(cat.Name) ? catImages[cat.Name] : "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400&q=80";
    }
}

<!-- Hero Section — Compact -->
<section class="home-hero">
    <div class="container">
        <div class="hero-grid">
            <div class="hero-content">
                <div class="hero-label">Thương hiệu phong cách sống tinh tế</div>
                <h1 class="hero-title serif">Nghệ thuật<br><em>Sống Đẳng Cấp.</em></h1>
                <p class="hero-subtitle">
                    Khám phá bộ sưu tập được tuyển chọn kỹ lưỡng — nơi kết nối giá trị thẩm mỹ với đời sống hiện đại.
                </p>
                <div class="hero-actions">
                    <a href="/Market" class="btn-dark" style="padding: 0.75rem 1.75rem; border-radius: 8px;">
                        Khám phá ngay
                    </a>
                    <a href="/Post" class="btn-outline" style="padding: 0.75rem 1.75rem; border-radius: 8px;">
                        Tìm hiểu thêm
                    </a>
                </div>
                <!-- Trust Stats -->
                <div class="hero-stats">
                    <div class="hero-stat">
                        <span class="hero-stat-value">1,200+</span>
                        <span class="hero-stat-label">Sản phẩm</span>
                    </div>
                    <div class="hero-stat">
                        <span class="hero-stat-value">500+</span>
                        <span class="hero-stat-label">Người bán</span>
                    </div>
                    <div class="hero-stat">
                        <span class="hero-stat-value">98%</span>
                        <span class="hero-stat-label">Hài lòng</span>
                    </div>
                </div>
            </div>
            <div class="hero-image">
                <img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=600&q=80" alt="MarketService - The Art of Living Well" />
            </div>
        </div>
    </div>
</section>

<!-- Shop by Category -->
<section class="narrative-section">
    <div class="container">
        <div class="section-header">
            <div>
                <div class="section-label">Theo dòng cảm hứng</div>
                <h2 class="section-title serif" style="font-size: 2.25rem;">Khám phá theo Câu chuyện</h2>
            </div>
            <a href="/Market" class="view-all">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>
        @if (categories.Any())
        {
            <div class="narrative-grid">
                @foreach (var cat in categories.Take(5))
                {
                    <a href="/Market?category=@Uri.EscapeDataString(cat.Name)" class="narrative-card">
                        <div class="narrative-image">
                            <img src="@GetCatImage(cat)" alt="@cat.Name" loading="lazy" />
                        </div>
                        <div class="narrative-name">@cat.Name</div>
                        <div class="narrative-count">@cat.ProductCount sản phẩm</div>
                    </a>
                }
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 3rem 0; color: var(--gray-500);">
                <i class="bi bi-grid-3x3-gap" style="font-size: 2rem; display: block; margin-bottom: 0.75rem;"></i>
                Chưa có danh mục nào
            </div>
        }
    </div>
</section>

<!-- Quick Search Bar -->
<section style="padding: 0 0 3rem;">
    <div class="container">
        <div class="home-search-bar">
            <i class="bi bi-search"></i>
            <input type="text" id="homeSearch" placeholder="Tìm kiếm vật phẩm, cảm hứng, thương hiệu..." onkeypress="if(event.key==='Enter') location.href='/Market?search=' + encodeURIComponent(this.value)">
            <button onclick="location.href='/Market?search=' + encodeURIComponent(document.getElementById('homeSearch').value)" class="btn-dark" style="padding: 0.625rem 1.5rem; border-radius: 6px; font-size: 0.85rem;">Tìm ngay</button>
        </div>
    </div>
</section>

<!-- Curated Products -->
<section class="section" style="padding-top: 0;">
    <div class="container">
        <div class="section-header">
            <div>
                <div class="section-label">Dành riêng cho bạn</div>
                <h2 class="section-title serif" style="font-size: 2.25rem;">Sản phẩm Tuyển chọn</h2>
                <p class="section-subtitle">Những vật phẩm tinh hoa được lựa chọn bởi cộng đồng đam mê cái đẹp.</p>
            </div>
            <a href="/Market" class="view-all">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="home-products-grid">
            @if (products.Any())
            {
                @foreach (var p in products.Take(8))
                {
                    <div class="home-product-card-wrap" style="position: relative;">
                        <button class="card-wishlist @(p.IsFavorite ? "active" : "")" 
                                data-wishlist-id="@p.Id"
                                onclick="event.preventDefault(); event.stopPropagation(); toggleWishlist(@p.Id, this)">
                            <i class="bi @(p.IsFavorite ? "bi-heart-fill" : "bi-heart")"></i>
                        </button>
                        <a href="/Market/Details/@p.Id" class="home-product-card">
                            <div class="home-product-img">
                                <img src="@(p.ImageUrl ?? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400&q=80")" alt="@p.Title" loading="lazy" />
                            </div>
                            <div class="home-product-body">
                                <div class="home-product-cat">@(p.Category ?? "Sản phẩm")</div>
                                <h3 class="home-product-title">@p.Title</h3>
                                <p class="home-product-price">@p.Price.ToString("N0") ₫</p>
                                <div class="home-product-meta">
                                    <span><i class="bi bi-person-circle"></i> @p.SellerName</span>
                                    <span class="time-ago" data-date="@p.CreatedAt.ToString("o")"></span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            }
            else
            {
                <div style="grid-column: 1/-1; text-align: center; padding: 4rem 0;">
                    <div style="font-size: 3rem; color: var(--gray-300); margin-bottom: 1rem;"><i class="bi bi-box-seam"></i></div>
                    <p style="color: var(--gray-500);">Chưa có sản phẩm nào. Hãy là người đầu tiên đăng bán!</p>
                    <a href="/Market/Create" class="btn-dark" style="margin-top: 1rem; padding: 0.75rem 2rem; border-radius: 8px; display: inline-block;">Đăng bán ngay</a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Features -->
<section class="features-section">
    <div class="container">
        <div style="text-align: center; margin-bottom: 3rem;">
            <div class="section-label" style="color: var(--gray-400);">Tại sao chọn chúng tôi</div>
            <h2 class="section-title" style="font-size: 2rem; color: var(--white);">Trải nghiệm mua sắm hoàn hảo</h2>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-lightning-charge"></i></div>
                <h3 class="feature-title">Nhanh chóng</h3>
                <p class="feature-desc">Tìm thấy thứ bạn cần chỉ trong vài giây với bộ lọc thông minh và giao diện tối giản.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-shield-lock"></i></div>
                <h3 class="feature-title">An toàn</h3>
                <p class="feature-desc">Hệ thống thanh toán bảo mật, người bán được định danh và kiểm duyệt nghiêm ngặt.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-chat-heart"></i></div>
                <h3 class="feature-title">Hỗ trợ 24/7</h3>
                <p class="feature-desc">Đội ngũ kỹ thuật luôn sẵn sàng giải đáp thắc mắc và hỗ trợ bạn mọi lúc.</p>
            </div>
        </div>
    </div>
</section>

<!-- The Journal (Posts) -->
<section class="news-section">
    <div class="container">
        <div class="section-header">
            <div>
                <div class="section-label">Kiến thức & Xu hướng</div>
                <h2 class="section-title serif" style="font-size: 2.25rem; font-style: italic;">Tạp chí Cộng đồng</h2>
            </div>
            <a href="/Post" class="view-all">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="news-grid">
            @if (posts.Any())
            {
                @foreach (var p in posts.Take(3))
                {
                    <a href="/Post/Details/@p.Id" class="news-card">
                        <div class="news-card-image">
                            <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=600&q=80" : p.ImageUrl)" alt="@p.Title" loading="lazy" />
                        </div>
                        <div class="news-card-meta">
                            <span>@p.AuthorName</span>
                            <span>•</span>
                            <span class="time-ago" data-date="@p.CreatedAt.ToString("o")"></span>
                        </div>
                        <h3 class="news-card-title">@p.Title</h3>
                        <p class="news-card-excerpt">
                            @(p.Content.Length > 120 ? p.Content.Substring(0, 120) + "..." : p.Content)
                        </p>
                    </a>
                }
            }
            else
            {
                <div style="grid-column: 1/-1; text-align: center; padding: 3rem 0; color: var(--gray-500);">
                    <i class="bi bi-journal-text" style="font-size: 2rem; display: block; margin-bottom: 0.75rem;"></i>
                    Chưa có bài viết nào
                </div>
            }
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta-section">
    <div class="container">
        <h2 class="cta-title">Bắt đầu bán hàng<br>ngay hôm nay.</h2>
        <p class="cta-subtitle">Tham gia cộng đồng hàng nghìn người bán và tiếp cận khách hàng tiềm năng trên toàn quốc.</p>
        <a href="/Market/Create" class="btn-dark" style="padding: 0.875rem 2.5rem; border-radius: 8px; font-size: 0.95rem;">
            Đăng sản phẩm miễn phí
        </a>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Time ago
            document.querySelectorAll('.time-ago').forEach(el => {
                const date = el.getAttribute('data-date');
                if (date) el.innerText = timeAgo(date);
            });

            // Scroll animations
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.narrative-card, .home-product-card, .feature-card, .news-card').forEach(el => {
                el.classList.add('animate-on-scroll');
                observer.observe(el);
            });
        });
    </script>
}
