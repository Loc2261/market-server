@if (User.Identity?.IsAuthenticated == true)
{
    <a href="/Chat" class="nav-btn" title="Tin nhắn">
        <i class="bi bi-chat-dots"></i>
        <span id="global-unread-badge" class="badge-count" style="display: none;">0</span>
    </a>

    <a href="/Market/Wishlist" class="nav-btn" title="Yêu thích">
        <i class="bi bi-heart"></i>
        <span class="badge-count d-none" id="wishlistBadge">0</span>
    </a>

    <a href="/Market/Cart" class="nav-btn" title="Giỏ hàng">
        <i class="bi bi-bag"></i>
    </a>

    <div class="user-dropdown">
        <div class="user-avatar">
            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
        </div>
        <span style="font-size: 0.875rem; font-weight: 600;">@User.Identity.Name</span>
        <i class="bi bi-chevron-down" style="font-size: 0.7rem; color: var(--gray-500);"></i>

        <div class="dropdown-menu-custom">
            <a href="/Profile" class="dropdown-item-custom">
                <i class="bi bi-person"></i> Trang cá nhân
            </a>
            <a href="/Order/MyOrders" class="dropdown-item-custom">
                <i class="bi bi-box-seam"></i> Đơn hàng
            </a>
            <a href="/Market/Wishlist" class="dropdown-item-custom">
                <i class="bi bi-heart"></i> Yêu thích
            </a>
            <a href="/Seller/Dashboard" class="dropdown-item-custom">
                <i class="bi bi-shop"></i> Kênh bán hàng
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a href="/Admin" class="dropdown-item-custom">
                    <i class="bi bi-shield-check"></i> Quản trị
                </a>
            }
            <hr style="margin: 0.25rem 0; opacity: 0.1;">
            <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                <button type="submit" class="dropdown-item-custom text-danger" style="width:100; border:0; background:transparent; text-align:left;">
                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                </button>
            </form>
        </div>
    </div>
}
else
{
    <a href="/Account/Login" class="btn-dark" style="padding: 0.5rem 1.5rem; font-size: 0.8rem; border-radius: 6px;">Đăng nhập</a>
    <a href="/Account/Register" class="btn-outline" style="padding: 0.5rem 1.5rem; font-size: 0.8rem; border-radius: 6px;">Đăng ký</a>
}
