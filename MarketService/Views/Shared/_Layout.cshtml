<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarketService</title>
    <meta name="description" content="Nền tảng thương mại curated — Mua bán tinh tế & Bảo mật" />

    <!-- Fonts: Playfair Display (serif) + Inter (sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buttons-forms.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <!-- SignalR -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
</head>
<body>
    <!-- Navbar -->
    <partial name="_Navbar" />

    <!-- Mobile Overlay -->
    <div class="mobile-overlay" id="mobileOverlay" onclick="closeMobileMenu()"></div>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobile-menu">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 2rem;">
            <span style="font-weight:700; font-size:1.1rem; text-transform:uppercase; letter-spacing:-0.03em;">Menu</span>
            <button onclick="closeMobileMenu()" style="background:none; border:none; font-size:1.5rem; cursor:pointer; color:var(--black);">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <a href="/" class="nav-link">Trang chủ</a>
        <a href="/Market" class="nav-link">Sản phẩm</a>
        <a href="/Post" class="nav-link">Cộng đồng</a>
        <hr style="border-top: 1px solid var(--gray-100); margin: 0.5rem 0;">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="/Profile" class="nav-link"><i class="bi bi-person me-2"></i>Trang cá nhân</a>
            <a href="/Order/MyOrders" class="nav-link"><i class="bi bi-box-seam me-2"></i>Đơn hàng</a>
            <a href="/Seller/Dashboard" class="nav-link"><i class="bi bi-shop me-2"></i>Kênh bán</a>
            <a href="/Chat" class="nav-link"><i class="bi bi-chat-dots me-2"></i>Tin nhắn</a>
            <a href="/Market/Cart" class="nav-link"><i class="bi bi-bag me-2"></i>Giỏ hàng</a>
            @if (User.IsInRole("Admin"))
            {
                <a href="/Admin" class="nav-link"><i class="bi bi-shield me-2"></i>Quản trị</a>
            }
            <hr style="border-top: 1px solid var(--gray-100); margin: 0.5rem 0;">
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" style="width:100%; text-align:left; padding:1rem 0; color:var(--danger); font-weight:600; font-size:0.95rem; background:none; border:none; cursor:pointer;">
                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                </button>
            </form>
        }
        else
        {
            <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;">
                <a href="/Account/Login" class="btn-dark" style="text-align:center; padding:0.75rem; border-radius:8px;">Đăng nhập</a>
                <a href="/Account/Register" class="btn-outline" style="text-align:center; padding:0.75rem; border-radius:8px;">Đăng ký</a>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="footer-brand">MarketService</div>
                    <p style="font-size: 0.875rem; line-height: 1.7; max-width: 320px; margin-bottom: 1.5rem;">
                        Nền tảng thương mại curated — nơi kết nối những sản phẩm chất lượng với người dùng tinh tế.
                    </p>
                </div>
                <div>
                    <h4>Khám phá</h4>
                    <div class="footer-links">
                        <a href="/Market">Sản phẩm</a>
                        <a href="/Post">Cộng đồng</a>
                        <a href="/Market/Create">Đăng bán</a>
                    </div>
                </div>
                <div>
                    <h4>Hỗ trợ</h4>
                    <div class="footer-links">
                        <a href="#">Hướng dẫn mua hàng</a>
                        <a href="#">Chính sách bảo mật</a>
                        <a href="#">Điều khoản sử dụng</a>
                    </div>
                </div>
                <div>
                    <h4>Liên hệ</h4>
                    <div class="footer-links">
                        <a href="mailto:hello@marketservice.vn">hello&#64;marketservice.vn</a>
                        <a href="#">Hotline: 1900 xxxx</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 MarketService. All rights reserved.</p>
                <div style="display:flex; gap:1rem;">
                    <a href="#" style="color:var(--gray-500);"><i class="bi bi-facebook"></i></a>
                    <a href="#" style="color:var(--gray-500);"><i class="bi bi-instagram"></i></a>
                    <a href="#" style="color:var(--gray-500);"><i class="bi bi-tiktok"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Toast -->
    <div id="toast-container"></div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>